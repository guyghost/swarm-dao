{
  "name": "@guyghost/swarm-dao-cli",
  "version": "0.13.0",
  "description": "Swarm DAO standalone CLI",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "swarm-dao": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@guyghost/swarm-dao-core": "^1.1.0",
    "@guyghost/swarm-dao-graph": "^0.4.0",
    "@guyghost/swarm-dao-herdr-adapter": "^0.5.1",
    "@guyghost/swarm-dao-improvement": "^0.6.8",
    "@guyghost/swarm-dao-product": "^0.3.7",
    "@guyghost/swarm-dao-tmux-adapter": "^0.4.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guyghost/swarm-dao.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/guyghost/swarm-dao/issues"
  },
  "homepage": "https://github.com/guyghost/swarm-dao#readme",
