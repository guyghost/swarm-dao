{
  "name": "@guyghost/swarm-dao-core",
  "version": "2.2.1",
  "description": "Swarm DAO core — pure business logic for AI agent governance",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models/improvement": {
      "types": "./dist/models/improvement.d.ts",
      "import": "./dist/models/improvement.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "import": "./dist/delivery/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "xstate": "^5.32.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^26.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guyghost/swarm-dao.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/guyghost/swarm-dao/issues"
  },
  "homepage": "https://github.com/guyghost/swarm-dao#readme",
  "author": "guyghost",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
