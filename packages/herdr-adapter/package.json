{
  "name": "@guyghost/swarm-dao-herdr-adapter",
  "version": "0.2.2",
  "description": "Swarm DAO herdr host — each deliberation agent runs as a real coding agent in a herdr workspace",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@guyghost/swarm-dao-core": "^0.8.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^26.0.1"
  },
  "keywords": [
    "swarm-dao",
    "herdr",
    "dao",
    "governance",
    "multi-agent",
    "deliberation",
    "ai-agents",
    "terminal"
  ],
  "author": "guyghost",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guyghost/swarm-dao.git",
    "directory": "packages/herdr-adapter"
  },
  "bugs": {
    "url": "https://github.com/guyghost/swarm-dao/issues"
  },
  "homepage": "https://github.com/guyghost/swarm-dao#readme",
  "publishConfig": {
    "access": "public"
  }
