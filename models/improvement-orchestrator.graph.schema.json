{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "improvement-orchestrator.graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "scope",
    "cycleStateAuthority",
    "proposalStateAuthority",
    "evidenceRoot",
    "improvementGraph",
    "owner",
    "nodes",
    "edges",
    "states",
    "terminalStates",
    "humanGatedStates",
    "workerKinds",
    "defaultWorkerKind",
    "maxWorkerRetries",
    "cooldownMs"
  ],
  "properties": {
    "$schema": { "const": "./improvement-orchestrator.graph.schema.json" },
    "id": { "const": "swarm-dao-improvement-orchestrator" },
    "version": { "const": 1 },
    "scope": { "const": "improvement-series" },
    "cycleStateAuthority": { "const": "none" },
    "proposalStateAuthority": { "const": "none" },
    "evidenceRoot": { "const": "evidence/improvement-series" },
    "improvementGraph": { "const": "models/improvement-loop.graph.json" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "authority"],
      "properties": {
        "id": { "const": "human-owner" },
        "kind": { "const": "human" },
        "authority": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "starts_series",
              "retries_workers",
              "restarts_halted_series",
              "cancels_series"
            ]
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "authority", "emits"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["state_machine", "deterministic"] },
          "authority": { "enum": ["series_state_only", "executor"] },
          "emits": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "type": {
            "enum": ["feeds", "validates", "owns_target", "authorizes", "vetoes", "gates", "frozen_commands_only"]
          }
        }
      }
    },
    "states": {
      "const": [
        "idle",
        "preparing",
        "sampling",
        "sealing",
        "auditing",
        "arbitrating",
        "grounding",
        "evaluating",
        "observing",
        "cooldown",
        "awaitingHumanCycleDecision",
        "workerFailed",
        "halted",
        "cancelled"
      ]
    },
    "terminalStates": { "const": ["idle", "cancelled"] },
    "humanGatedStates": { "const": ["awaitingHumanCycleDecision", "workerFailed", "halted"] },
    "workerKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" }
    },
    "defaultWorkerKind": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
    "maxWorkerRetries": { "const": 2 },
    "cooldownMs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 60000 }
      }
    }
  }
}
