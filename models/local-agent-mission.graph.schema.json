{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-agent-mission.graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "version",
    "scope",
    "milestone",
    "platform",
    "authority",
    "eventSources",
    "entities",
    "policyModel",
    "machines",
    "crossMachineRules",
    "retryModel",
    "effectProtocol",
    "globalInvariants",
    "plannedXStateMachines",
    "deferred"
  ],
  "properties": {
    "$schema": { "const": "./local-agent-mission.graph.schema.json" },
    "id": { "const": "swarm-dao-local-agent-mission" },
    "version": { "const": 1 },
    "scope": { "const": "macos-local-shared-mission-thread" },
    "milestone": { "const": "m1-model-review" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "preferredUi", "executionBoundary", "projectBoundary"],
      "properties": {
        "kind": { "const": "native-macos" },
        "preferredUi": { "const": "SwiftUI" },
        "executionBoundary": { "const": "local-mac" },
        "projectBoundary": { "const": "distinct-monorepo-project" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missionState",
        "agentState",
        "subagentRequestState",
        "policyOverrideState",
        "llm",
        "freeFormTextTransitions"
      ],
      "properties": {
        "missionState": { "const": "mission-machine" },
        "agentState": { "const": "agent-machine" },
        "subagentRequestState": { "const": "subagent-request-machine" },
        "policyOverrideState": { "const": "policy-override-machine" },
        "llm": { "const": "signal-only" },
        "freeFormTextTransitions": { "const": false }
      }
    },
    "eventSources": {
      "const": ["human", "ai", "system", "tool"]
    },
    "entities": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entity" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "team-template" } }, "required": ["id"] } },
        {
          "contains": {
            "properties": { "id": { "const": "mission-template-snapshot" } },
            "required": ["id"]
          }
        },
        { "contains": { "properties": { "id": { "const": "mission-message" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "agent-record" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "autonomy-contract" } }, "required": ["id"] } },
        {
          "contains": {
            "properties": { "id": { "const": "decision-journal-entry" } },
            "required": ["id"]
          }
        }
      ]
    },
    "policyModel": { "$ref": "#/$defs/policyModel" },
    "machines": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/machine" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "mission-machine" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "agent-machine" } }, "required": ["id"] } },
        {
          "contains": {
            "properties": { "id": { "const": "subagent-request-machine" } },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "properties": { "id": { "const": "policy-override-machine" } },
            "required": ["id"]
          }
        }
      ]
    },
    "crossMachineRules": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/numberedRule" }
    },
    "retryModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorClassification", "clock", "idempotencyKey", "rules"],
      "properties": {
        "errorClassification": { "const": "deterministic-error-code-registry" },
        "clock": { "const": "injected-deadline-events" },
        "idempotencyKey": { "const": "missionId:aggregateId:operation:attempt" },
        "rules": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "effectProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionOrder", "invariants"],
      "properties": {
        "decisionOrder": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "invariants": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "globalInvariants": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/numberedRule" }
    },
    "plannedXStateMachines": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contract", "plannedPath"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "contract": {
            "enum": [
              "mission-machine",
              "agent-machine",
              "subagent-request-machine",
              "policy-override-machine"
            ]
          },
          "plannedPath": {
            "type": "string",
            "pattern": "^packages/core/src/models/[a-z0-9-]+\\.machine\\.ts$"
          }
        }
      }
    },
    "deferred": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mutability", "requiredFields", "commands", "invariants"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "mutability": { "$ref": "#/$defs/nonEmptyString" },
        "requiredFields": { "$ref": "#/$defs/nonEmptyStrings" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "invariants": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "policyLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "mutable"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "priority": { "type": "integer", "minimum": 1 },
        "mutable": { "type": "boolean" },
        "missionOverrideable": { "type": "boolean" },
        "missionOverrideableByField": { "type": "boolean" }
      },
      "oneOf": [
        { "required": ["missionOverrideable"] },
        { "required": ["missionOverrideableByField"] }
      ]
    },
    "policyModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "dimensions", "evaluationOrder", "invariants"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/policyLayer" }
        },
        "dimensions": {
          "const": [
            "allowedToolIds",
            "budgetLimits",
            "delegationLimits",
            "fileAccessRules",
            "validationThresholds",
            "retryLimits"
          ]
        },
        "evaluationOrder": {
          "type": "array",
          "minItems": 8,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "invariants": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "terminal"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "terminal": { "type": "boolean" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sources"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["human", "ai", "system", "tool"] }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "event", "guard", "to", "effects"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[MASO][0-9]{2}$"
        },
        "from": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "event": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "guard": { "$ref": "#/$defs/identifier" },
        "to": {
          "anyOf": [
            { "$ref": "#/$defs/identifier" },
            { "const": "$same" }
          ]
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "initial",
        "states",
        "events",
        "transitions",
        "forbidden",
        "terminalStates"
      ],
      "properties": {
        "id": {
          "enum": [
            "mission-machine",
            "agent-machine",
            "subagent-request-machine",
            "policy-override-machine"
          ]
        },
        "initial": { "$ref": "#/$defs/identifier" },
        "states": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/state" }
        },
        "events": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/event" }
        },
        "transitions": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/transition" }
        },
        "forbidden": { "$ref": "#/$defs/nonEmptyStrings" },
        "terminalStates": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "numberedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(X[0-9]{2}|INV-[0-9]{2})$"
        },
        "rule": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
