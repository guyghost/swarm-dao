  "crossMachineRules": [
    {
      "id": "X01",
      "rule": "A mission owns every agent, subagent request and policy override correlated by missionId; cross-mission references are rejected."
    },
    {
      "id": "X02",
      "rule": "An accepted subagent signal creates a request only when the parent agent snapshot is active."
    },
    {
      "id": "X03",
      "rule": "A child agent record is created only after its request reaches approved, and its parentAgentId and missionId are immutable."
    },
    {
      "id": "X04",
      "rule": "Stopping a parent computes a deterministic descendants-first plan from the persisted parent graph; the parent cannot acknowledge stopped before every descendant is completed, cancelled, failed or interrupted."
    },
    {
      "id": "X05",
      "rule": "Mission cancellation or failure cancels all non-terminal subagent requests, stops every live agent descendants-first and expires every active override before the mission reaches its terminal state."
    },
    {
      "id": "X06",
      "rule": "Mission completion requires all required agents terminal, no live descendants, no open subagent request, no unresolved human blocker and deterministic completion evidence."
    },
    {
      "id": "X07",
      "rule": "Agent and request failures are signals to the mission model; application or UI code cannot assign a mission target state."
    },
    {
      "id": "X08",
      "rule": "Policy evaluation consumes canonical facts and model configuration; a tool reports facts and evidence but never an allow or deny verdict."
    },
    {
      "id": "X09",
      "rule": "An active override cannot be removed while a live agent or request depends on it; terminalization expires overrides only after dependent work is quiescent."
    }
  ],
  "retryModel": {
    "errorClassification": "deterministic-error-code-registry",
    "clock": "injected-deadline-events",
    "idempotencyKey": "missionId:aggregateId:operation:attempt",
    "rules": [
      "every retry family has a finite system ceiling and a finite mission-contract limit",
      "attempt increments before an effect is scheduled",
      "automatic retry is allowed only below both limits and below the human-validation threshold",
      "a retry above the automatic threshold requires an exact human authorization event",
      "non-retryable errors never enter retry_wait",
      "replay of the same idempotency key cannot duplicate a process, child, message or budget charge"
    ]
  },
  "effectProtocol": {
    "decisionOrder": [
      "validate event schema, source principal and current snapshot",
      "run pure guards and select exactly one declared transition",
      "atomically persist next snapshot, journal entry and effect intents",
      "execute committed effect intents outside the model",
      "return typed acknowledgements as new events"
    ],
    "invariants": [
      "no external effect runs before its intent is durably committed",
      "effect execution never mutates model state directly",
      "recovery replays committed intents by idempotency key",
      "unmatched, malformed, wrong-source and post-terminal events are rejected and journaled",
      "a persistence failure commits neither the transition nor its effects"
    ]
  },
  "globalInvariants": [
    {
      "id": "INV-01",
      "rule": "Only the four declared machines change their respective states."
    },
    {
      "id": "INV-02",
      "rule": "An LLM produces content or typed signals only and can never select a target state, command, approval, retry, cancellation, permission grant or policy verdict."
    },
    {
      "id": "INV-03",
      "rule": "Free-form text is never parsed into a state-transition event."
    },
    {
      "id": "INV-04",
      "rule": "Every launched mission owns an immutable template and autonomy-contract snapshot."
    },
    {
      "id": "INV-05",
      "rule": "Every agent and subagent request belongs to exactly one mission; every child has a traceable parent in that mission."
    },
    {
      "id": "INV-06",
      "rule": "System ceilings are immutable and cannot be overridden."
    },
    {
      "id": "INV-07",
      "rule": "Mission overrides require explicit human confirmation of an exact structured diff, are journaled and expire with the mission."
    },
    {
      "id": "INV-08",
      "rule": "The shared thread contains human-facing messages and decision notices only; technical activity remains on the agent record."
    },
    {
      "id": "INV-09",
      "rule": "Terminal machine states are immutable."
    },
    {
      "id": "INV-10",
      "rule": "Parent interruption and cancellation handle descendants before parent quiescence."
    },
    {
      "id": "INV-11",
      "rule": "All budgets, retries, permissions and validation thresholds are evaluated deterministically from structured data."
    },
    {
      "id": "INV-12",
      "rule": "Model functions perform no I/O and use no ambient clock, randomness, process API, filesystem API or host SDK."
    },
    {
      "id": "INV-13",
      "rule": "The M1 runtime launches local agents itself and has no adapter catalogue, adapter manifest or configuration-assistant dependency."
    },
    {
      "id": "INV-14",
      "rule": "A mission is paused only after all live agents are restartably quiescent and no start intent remains open."
    },
    {
      "id": "INV-15",
      "rule": "A process absence acknowledgement cannot complete an agent stop while a launch intent for that agent remains open."
    },
    {
      "id": "INV-16",
      "rule": "All LLM calls live in dedicated AI workers behind typed signal ports; UI, application, policy, persistence and process layers do not invoke an LLM inline."
    }
  ],
