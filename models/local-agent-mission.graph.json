{
  "$schema": "./local-agent-mission.graph.schema.json",
  "id": "swarm-dao-local-agent-mission",
  "version": 1,
  "scope": "macos-local-shared-mission-thread",
  "milestone": "m1-model-review",
  "platform": {
    "kind": "native-macos",
    "preferredUi": "SwiftUI",
    "executionBoundary": "local-mac",
    "projectBoundary": "distinct-monorepo-project"
  },
  "authority": {
    "missionState": "mission-machine",
    "agentState": "agent-machine",
    "subagentRequestState": "subagent-request-machine",
    "policyOverrideState": "policy-override-machine",
    "llm": "signal-only",
    "freeFormTextTransitions": false
  },
  "eventSources": ["human", "ai", "system", "tool"],
  "entities": [
    {
      "id": "team-template",
      "mutability": "append-only-revisions",
      "requiredFields": [
        "templateId",
        "revision",
        "origin",
        "name",
        "agents",
        "createdBy",
        "createdAt"
      ],
      "commands": ["CREATE_TEMPLATE", "SAVE_TEMPLATE_REVISION", "DUPLICATE_TEMPLATE"],
      "invariants": [
        "built-in revisions are immutable",
        "saving an edit creates a new revision",
        "duplicating creates a new templateId with lineage",
        "templates never carry mission runtime state"
      ]
    },
    {
      "id": "mission-template-snapshot",
      "mutability": "immutable-after-launch",
      "requiredFields": [
        "snapshotId",
        "missionId",
        "sourceTemplateId",
        "sourceRevision",
        "normalizedTeam",
        "autonomyContract",
        "contentHash",
        "sealedAt"
      ],
      "commands": ["SEAL_MISSION_TEMPLATE_SNAPSHOT"],
      "invariants": [
        "one snapshot belongs to exactly one mission",
        "launch is rejected without a snapshot hash",
        "later template revisions cannot change a launched mission",
        "the autonomy contract is structured and contains no free-form transition instruction"
      ]
    },
    {
      "id": "mission-message",
      "mutability": "append-only",
      "requiredFields": [
        "messageId",
        "missionId",
        "author",
        "visibility",
        "kind",
        "content",
        "createdAt"
      ],
      "commands": ["APPEND_HUMAN_MESSAGE", "APPEND_AGENT_MESSAGE", "APPEND_SYSTEM_NOTICE"],
      "invariants": [
        "M1 accepts only mission_shared visibility",
        "the visibility envelope already supports mission_shared or direct",
        "direct visibility is rejected with feature_not_enabled in M1",
        "raw prompts, chain-of-thought, stdout, stderr, tool payloads, stack traces, tokens and secrets never enter the shared thread",
        "subagent refusals and human-validation requests create visible system notices"
      ]
    },
    {
      "id": "agent-record",
      "mutability": "state-machine-plus-append-only-activity",
      "requiredFields": [
        "agentId",
        "missionId",
        "role",
        "state",
        "effectivePermissions",
        "parentAgentId",
        "capabilities",
        "activityJournal"
      ],
      "commands": ["APPEND_AGENT_ACTIVITY"],
      "invariants": [
        "every agent belongs to exactly one mission",
        "parentAgentId is null only for top-level agents",
        "parent and child belong to the same mission",
        "the activity journal is technical and is not rendered as shared-thread content",
        "chain-of-thought and secrets are never persisted in the activity journal"
      ]
    },
    {
      "id": "autonomy-contract",
      "mutability": "immutable-base-plus-expiring-overrides",
      "requiredFields": [
        "allowedToolIds",
        "budgetLimits",
        "delegationLimits",
        "fileAccessRules",
        "validationThresholds",
        "retryLimits"
      ],
      "commands": ["VALIDATE_AUTONOMY_CONTRACT"],
      "invariants": [
        "all policy dimensions are structured",
        "missing dimensions fail closed",
        "the launch contract cannot exceed effective policy",
        "runtime overrides do not mutate the sealed base contract"
      ]
    },
    {
      "id": "decision-journal-entry",
      "mutability": "append-only",
      "requiredFields": [
        "entryId",
        "missionId",
        "aggregateType",
        "aggregateId",
        "eventType",
        "source",
        "accepted",
        "reasonCode",
        "occurredAt",
        "sequence"
      ],
      "commands": ["APPEND_DECISION_JOURNAL_ENTRY"],
      "invariants": [
        "accepted and rejected events are journaled",
        "sequence is strictly monotonic per mission",
        "timestamps are injected and never read by a pure model guard",
        "payloads are redacted before persistence"
      ]
    }
  ],
  "policyModel": {
    "layers": [
      {
        "id": "system-ceilings",
        "priority": 1,
        "mutable": false,
        "missionOverrideable": false
      },
      {
        "id": "application-global-rules",
        "priority": 2,
        "mutable": true,
        "missionOverrideableByField": true
      },
      {
        "id": "mission-autonomy-contract",
        "priority": 3,
        "mutable": false,
        "missionOverrideableByField": true
      },
      {
        "id": "confirmed-mission-overrides",
        "priority": 4,
        "mutable": false,
        "missionOverrideableByField": false
      }
    ],
    "dimensions": [
      "allowedToolIds",
      "budgetLimits",
      "delegationLimits",
      "fileAccessRules",
      "validationThresholds",
      "retryLimits"
    ],
    "evaluationOrder": [
      "reject malformed or incomplete facts",
      "reject any system-ceiling violation",
      "apply global rules",
      "apply the sealed mission autonomy contract",
      "apply only active, exact-scope, human-confirmed mission overrides",
      "re-check system ceilings",
      "reserve budget atomically",
      "emit allow, requires_human_confirmation or deny with reason codes"
    ],
    "invariants": [
      "system ceilings can never be relaxed",
      "a field marked non-overrideable can never be relaxed for a mission",
      "an override is bound to one mission, one exact policy diff and one human principal",
      "an override expires when its mission reaches a terminal state",
      "allowlists are intersected unless an eligible active override explicitly expands an overrideable lower layer",
      "numeric maxima never exceed the system ceiling",
      "file paths are canonicalized by a trusted tool and checked against read and write roots separately",
      "symlink or path-resolution uncertainty fails closed",
      "budget reservation and consumption are atomic and append-only",
      "global rules are append-only revisions and every authorization is bound to the evaluated revision",
      "a tighter global revision applies to the next uncommitted effect while a looser revision never expands a sealed mission contract implicitly",
      "an AI signal cannot contain a permission grant, override confirmation or policy verdict"
    ]
  },
  "machines": [
    {
      "id": "mission-machine",
      "initial": "draft",
      "states": [
        { "id": "draft", "terminal": false },
        { "id": "pending", "terminal": false },
        { "id": "active", "terminal": false },
        { "id": "pausing", "terminal": false },
        { "id": "paused", "terminal": false },
        { "id": "human_intervention_required", "terminal": false },
        { "id": "cancelling", "terminal": false },
        { "id": "failing", "terminal": false },
        { "id": "completed", "terminal": true },
        { "id": "cancelled", "terminal": true },
        { "id": "failed", "terminal": true }
      ],
      "events": [
        { "type": "MISSION_DRAFT_UPDATED", "sources": ["human"] },
        { "type": "MISSION_LAUNCH_REQUESTED", "sources": ["human"] },
        { "type": "MISSION_ACTIVATION_EVALUATED", "sources": ["system"] },
        { "type": "MISSION_PAUSE_REQUESTED", "sources": ["human"] },
        { "type": "MISSION_PAUSE_QUIESCENCE_EVALUATED", "sources": ["system"] },
        { "type": "MISSION_RESUME_REQUESTED", "sources": ["human"] },
        { "type": "AGENT_SIGNAL_RECORDED", "sources": ["ai"] },
        { "type": "MISSION_HUMAN_INTERVENTION_REQUIRED", "sources": ["system"] },
        { "type": "MISSION_INTERVENTION_EVALUATED", "sources": ["system"] },
        { "type": "MISSION_COMPLETION_EVALUATED", "sources": ["system"] },
        { "type": "MISSION_CANCEL_REQUESTED", "sources": ["human"] },
        { "type": "MISSION_FAILURE_RECORDED", "sources": ["system", "tool"] },
        { "type": "MISSION_QUIESCENCE_EVALUATED", "sources": ["system"] },
        { "type": "HUMAN_MESSAGE_SUBMITTED", "sources": ["human"] }
      ],
      "transitions": [
        {
          "id": "M01",
          "from": ["draft"],
          "event": "MISSION_DRAFT_UPDATED",
          "guard": "ownerAndStructuredDraft",
          "to": "draft",
          "effects": ["persistMissionDraft", "journalDecision"]
        },
        {
          "id": "M02",
          "from": ["draft"],
          "event": "MISSION_LAUNCH_REQUESTED",
          "guard": "ownerValidTemplateValidContractNoUnconfirmedOverrides",
          "to": "pending",
          "effects": [
            "sealMissionTemplateSnapshot",
            "createTopLevelAgentRecords",
            "requestTopLevelAgentStarts",
            "journalDecision"
          ]
        },
        {
          "id": "M03",
          "from": ["pending"],
          "event": "MISSION_ACTIVATION_EVALUATED",
          "guard": "allRequiredTopLevelAgentsActive",
          "to": "active",
          "effects": ["appendMissionActivatedNotice", "journalDecision"]
        },
        {
          "id": "M04",
          "from": ["pending"],
          "event": "MISSION_ACTIVATION_EVALUATED",
          "guard": "startupNeedsHumanIntervention",
          "to": "human_intervention_required",
          "effects": ["recordInterventionOriginPending", "appendHumanInterventionNotice", "journalDecision"]
        },
        {
          "id": "M05",
          "from": ["pending"],
          "event": "MISSION_ACTIVATION_EVALUATED",
          "guard": "startupStillInProgress",
          "to": "pending",
          "effects": ["journalDecision"]
        },
        {
          "id": "M06",
          "from": ["active"],
          "event": "MISSION_PAUSE_REQUESTED",
          "guard": "missionOwner",
          "to": "pausing",
          "effects": ["requestRestartableAgentInterruptCascade", "appendMissionPausingNotice", "journalDecision"]
        },
        {
          "id": "M07",
          "from": ["paused"],
          "event": "MISSION_RESUME_REQUESTED",
          "guard": "missionOwnerNoBlockingOverrideAndAllAgentsRestartablyQuiescent",
          "to": "pending",
          "effects": ["requestInterruptedAgentRestarts", "appendMissionResumeNotice", "journalDecision"]
        },
        {
          "id": "M08",
          "from": ["active"],
          "event": "AGENT_SIGNAL_RECORDED",
          "guard": "validHumanInputRequiredSignalFromActiveMissionAgent",
          "to": "human_intervention_required",
          "effects": ["recordInterventionOriginActive", "appendHumanInterventionNotice", "journalDecision"]
        },
        {
          "id": "M09",
          "from": ["active"],
          "event": "AGENT_SIGNAL_RECORDED",
          "guard": "validSubagentRequestSignalFromActiveMissionAgent",
          "to": "active",
          "effects": ["createSubagentRequest", "journalDecision"]
        },
        {
          "id": "M10",
          "from": ["active"],
          "event": "AGENT_SIGNAL_RECORDED",
          "guard": "validSharedMessageSignalFromActiveMissionAgent",
          "to": "active",
          "effects": ["appendSanitizedAgentMessage", "journalDecision"]
        },
        {
          "id": "M11",
          "from": ["human_intervention_required"],
          "event": "MISSION_INTERVENTION_EVALUATED",
          "guard": "allBlockersResolvedAndOriginActive",
          "to": "active",
          "effects": ["appendInterventionResolvedNotice", "journalDecision"]
        },
        {
          "id": "M12",
          "from": ["human_intervention_required"],
          "event": "MISSION_INTERVENTION_EVALUATED",
          "guard": "allBlockersResolvedAndOriginPending",
          "to": "pending",
          "effects": ["requestEligibleAgentRestarts", "appendInterventionResolvedNotice", "journalDecision"]
        },
        {
          "id": "M13",
          "from": ["human_intervention_required"],
          "event": "MISSION_INTERVENTION_EVALUATED",
          "guard": "blockersRemain",
          "to": "human_intervention_required",
          "effects": ["journalDecision"]
        },
        {
          "id": "M14",
          "from": ["active"],
          "event": "MISSION_COMPLETION_EVALUATED",
          "guard": "completionEvidenceAndAllWorkTerminal",
          "to": "completed",
          "effects": ["expireMissionOverrides", "appendMissionCompletedNotice", "journalDecision"]
        },
        {
          "id": "M15",
          "from": ["draft"],
          "event": "MISSION_CANCEL_REQUESTED",
          "guard": "missionOwner",
          "to": "cancelled",
          "effects": ["expireMissionOverrides", "journalDecision"]
        },
        {
          "id": "M16",
          "from": ["pending", "active", "pausing", "paused", "human_intervention_required"],
          "event": "MISSION_CANCEL_REQUESTED",
          "guard": "missionOwner",
          "to": "cancelling",
          "effects": ["requestTerminalAgentCancelCascade", "cancelOpenSubagentRequests", "journalDecision"]
        },
        {
          "id": "M17",
          "from": ["pending", "active", "pausing", "paused", "human_intervention_required", "cancelling"],
          "event": "MISSION_FAILURE_RECORDED",
          "guard": "trustedFatalErrorCode",
          "to": "failing",
          "effects": ["requestTerminalAgentCancelCascade", "cancelOpenSubagentRequests", "journalDecision"]
        },
        {
          "id": "M18",
          "from": ["cancelling"],
          "event": "MISSION_QUIESCENCE_EVALUATED",
          "guard": "allAgentsAndRequestsQuiescent",
          "to": "cancelled",
          "effects": ["expireMissionOverrides", "appendMissionCancelledNotice", "journalDecision"]
        },
        {
          "id": "M19",
          "from": ["failing"],
          "event": "MISSION_QUIESCENCE_EVALUATED",
          "guard": "allAgentsAndRequestsQuiescent",
          "to": "failed",
          "effects": ["expireMissionOverrides", "appendMissionFailedNotice", "journalDecision"]
        },
        {
          "id": "M20",
          "from": ["draft", "pending", "active", "pausing", "paused", "human_intervention_required"],
          "event": "HUMAN_MESSAGE_SUBMITTED",
          "guard": "authorizedParticipantAndMissionSharedVisibility",
          "to": "$same",
          "effects": ["appendHumanMessage", "journalDecision"]
        },
        {
          "id": "M21",
          "from": ["active"],
          "event": "MISSION_HUMAN_INTERVENTION_REQUIRED",
          "guard": "openStructuredHumanBlocker",
          "to": "human_intervention_required",
          "effects": ["recordInterventionOriginActive", "appendHumanInterventionNotice", "journalDecision"]
        },
        {
          "id": "M22",
          "from": ["pausing"],
          "event": "MISSION_PAUSE_QUIESCENCE_EVALUATED",
          "guard": "allAgentsRestartablyQuiescentAndNoOpenStartIntent",
          "to": "paused",
          "effects": ["appendMissionPausedNotice", "journalDecision"]
        }
      ],
      "forbidden": [
        "launch outside draft",
        "launch from free-form text",
        "activation while any required top-level agent is not active",
        "completion with open subagent requests, active descendants, unresolved blockers or missing completion evidence",
        "resume outside paused",
        "post-terminal events",
        "direct messages in M1",
        "AI pause, resume, cancel, launch, completion or policy decision events"
      ],
      "terminalStates": ["completed", "cancelled", "failed"]
    },
    {
      "id": "agent-machine",
      "initial": "ready",
      "states": [
        { "id": "ready", "terminal": false },
        { "id": "starting", "terminal": false },
        { "id": "active", "terminal": false },
        { "id": "waiting_for_human", "terminal": false },
        { "id": "retry_wait", "terminal": false },
        { "id": "interrupted", "terminal": false },
        { "id": "stopping", "terminal": false },
        { "id": "failing", "terminal": false },
        { "id": "completed", "terminal": true },
        { "id": "cancelled", "terminal": true },
        { "id": "failed", "terminal": true }
      ],
      "events": [
        { "type": "AGENT_START_AUTHORIZED", "sources": ["system"] },
        { "type": "PROCESS_STARTED", "sources": ["tool"] },
        { "type": "PROCESS_START_FAILED", "sources": ["tool"] },
        { "type": "AGENT_SIGNAL_RECORDED", "sources": ["ai"] },
        { "type": "HUMAN_RESPONSE_RECORDED", "sources": ["human"] },
        { "type": "PROCESS_EXITED", "sources": ["tool"] },
        { "type": "AGENT_INTERRUPT_REQUESTED", "sources": ["human", "system"] },
        { "type": "AGENT_CANCEL_REQUESTED", "sources": ["system"] },
        { "type": "DESCENDANTS_QUIESCENT", "sources": ["system"] },
        { "type": "PROCESS_STOPPED", "sources": ["tool"] },
        { "type": "LOCAL_PROCESS_ABSENT", "sources": ["tool"] },
        { "type": "PROCESS_STOP_FAILED", "sources": ["tool"] },
        { "type": "STOP_RETRY_DUE", "sources": ["system"] },
        { "type": "AGENT_RESTART_AUTHORIZED", "sources": ["human", "system"] },
        { "type": "AGENT_RETRY_DUE", "sources": ["system"] },
        { "type": "AGENT_RETRY_AUTHORIZED", "sources": ["human"] }
      ],
      "transitions": [
        {
          "id": "A01",
          "from": ["ready"],
          "event": "AGENT_START_AUTHORIZED",
          "guard": "missionAllowsStartAndPolicyReservationSucceeded",
          "to": "starting",
          "effects": ["requestLocalAgentProcessStart", "journalDecision"]
        },
        {
          "id": "A02",
          "from": ["starting"],
          "event": "PROCESS_STARTED",
          "guard": "matchingLaunchTokenAndLocalProcessIdentity",
          "to": "active",
          "effects": ["resolveMatchingRetryBlockerIfPresent", "appendAgentActivity", "journalDecision"]
        },
        {
          "id": "A03",
          "from": ["starting"],
          "event": "PROCESS_START_FAILED",
          "guard": "retryableErrorAndAutomaticRetryAvailable",
          "to": "retry_wait",
          "effects": ["incrementStartAttempt", "scheduleAgentRetry", "appendAgentActivity", "journalDecision"]
        },
        {
          "id": "A04",
          "from": ["starting"],
          "event": "PROCESS_START_FAILED",
          "guard": "nonRetryableOrRetryBudgetExhausted",
          "to": "failed",
          "effects": ["releaseUnusedReservation", "appendAgentActivity", "signalMissionBlocker", "journalDecision"]
        },
        {
          "id": "A25",
          "from": ["starting"],
          "event": "PROCESS_START_FAILED",
          "guard": "retryableErrorAndHumanConfirmationRequired",
          "to": "retry_wait",
          "effects": [
            "incrementStartAttempt",
            "openHumanRetryRequest",
            "signalMissionBlocker",
            "appendAgentActivity",
            "journalDecision"
          ]
        },
        {
          "id": "A05",
          "from": ["retry_wait"],
          "event": "AGENT_RETRY_DUE",
          "guard": "automaticRetryAuthorizedByPolicyAndDeadlineReached",
          "to": "starting",
          "effects": ["requestLocalAgentProcessStart", "journalDecision"]
        },
        {
          "id": "A06",
          "from": ["active"],
          "event": "AGENT_SIGNAL_RECORDED",
          "guard": "validHumanInputRequiredSignal",
          "to": "waiting_for_human",
          "effects": ["appendAgentActivity", "signalMissionBlocker", "journalDecision"]
        },
        {
          "id": "A07",
          "from": ["active"],
          "event": "AGENT_SIGNAL_RECORDED",
          "guard": "validContentOrSubagentSignal",
          "to": "active",
          "effects": ["appendAgentActivity", "journalDecision"]
        },
        {
          "id": "A08",
          "from": ["waiting_for_human"],
          "event": "HUMAN_RESPONSE_RECORDED",
          "guard": "authorizedHumanResponseMatchesOpenRequest",
          "to": "active",
          "effects": ["deliverHumanResponseToAgent", "resolveMissionBlocker", "appendAgentActivity", "journalDecision"]
        },
        {
          "id": "A09",
          "from": ["active", "waiting_for_human"],
          "event": "PROCESS_EXITED",
          "guard": "expectedSuccessfulExitWithCompletionEvidence",
          "to": "completed",
          "effects": ["releaseAgentReservations", "appendAgentActivity", "journalDecision"]
        },
        {
          "id": "A10",
          "from": ["active", "waiting_for_human"],
          "event": "PROCESS_EXITED",
          "guard": "unexpectedRetryableExitAndAutomaticRetryAvailable",
          "to": "retry_wait",
          "effects": ["incrementRuntimeAttempt", "scheduleAgentRetry", "appendAgentActivity", "journalDecision"]
        },
        {
          "id": "A11",
          "from": ["active", "waiting_for_human"],
          "event": "PROCESS_EXITED",
          "guard": "unexpectedNonRetryableExitOrRetryBudgetExhausted",
          "to": "failing",
          "effects": [
            "releaseAgentReservations",
            "requestTerminalDescendantCancel",
            "appendAgentActivity",
            "signalMissionBlocker",
            "journalDecision"
          ]
        },
        {
          "id": "A26",
          "from": ["active", "waiting_for_human"],
          "event": "PROCESS_EXITED",
          "guard": "unexpectedRetryableExitAndHumanConfirmationRequired",
          "to": "retry_wait",
          "effects": [
            "incrementRuntimeAttempt",
            "openHumanRetryRequest",
            "signalMissionBlocker",
            "appendAgentActivity",
            "journalDecision"
          ]
        },
        {
          "id": "A12",
          "from": ["ready", "starting", "active", "waiting_for_human", "retry_wait", "interrupted"],
          "event": "AGENT_INTERRUPT_REQUESTED",
          "guard": "authorizedRestartableInterrupt",
          "to": "stopping",
          "effects": [
            "recordRestartableStopReason",
            "cancelOpenLaunchIntent",
            "requestDescendantsFirstStop",
            "journalDecision"
          ]
        },
        {
          "id": "A13",
          "from": ["ready", "starting", "active", "waiting_for_human", "retry_wait", "interrupted"],
          "event": "AGENT_CANCEL_REQUESTED",
          "guard": "missionOrParentCancelCascade",
          "to": "stopping",
          "effects": [
            "recordTerminalStopReason",
            "cancelOpenLaunchIntent",
            "requestDescendantsFirstStop",
            "journalDecision"
          ]
        },
        {
          "id": "A14",
          "from": ["stopping"],
          "event": "DESCENDANTS_QUIESCENT",
          "guard": "allDescendantsQuiescentAndNoOpenLaunchIntent",
          "to": "stopping",
          "effects": ["requestLocalAgentProcessStopOrAbsenceEvidence", "journalDecision"]
        },
        {
          "id": "A15",
          "from": ["stopping"],
          "event": "PROCESS_STOPPED",
          "guard": "matchingStopTokenRestartableReasonAndDescendantsQuiescent",
          "to": "interrupted",
          "effects": ["releaseAgentReservations", "appendAgentActivity", "journalDecision"]
        },
        {
          "id": "A16",
          "from": ["stopping"],
          "event": "PROCESS_STOPPED",
          "guard": "matchingStopTokenTerminalReasonAndDescendantsQuiescent",
          "to": "cancelled",
          "effects": ["releaseAgentReservations", "appendAgentActivity", "journalDecision"]
        },
        {
          "id": "A17",
          "from": ["stopping"],
          "event": "PROCESS_STOP_FAILED",
          "guard": "stopRetryAvailable",
          "to": "stopping",
          "effects": ["incrementStopAttempt", "scheduleStopRetry", "appendAgentActivity", "journalDecision"]
        },
        {
          "id": "A18",
          "from": ["stopping"],
          "event": "STOP_RETRY_DUE",
          "guard": "injectedDeadlineReachedAndDescendantsQuiescent",
          "to": "stopping",
          "effects": ["requestLocalAgentProcessStop", "journalDecision"]
        },
        {
          "id": "A19",
          "from": ["stopping"],
          "event": "PROCESS_STOP_FAILED",
          "guard": "stopRetryExhausted",
          "to": "failed",
          "effects": ["appendAgentActivity", "signalMissionFatalCleanupError", "journalDecision"]
        },
        {
          "id": "A20",
          "from": ["interrupted"],
          "event": "AGENT_RESTART_AUTHORIZED",
          "guard": "restartableReasonAndMissionAllowsStartAndPolicyReservationSucceeded",
          "to": "starting",
          "effects": ["requestLocalAgentProcessStart", "journalDecision"]
        },
        {
          "id": "A21",
          "from": ["retry_wait"],
          "event": "AGENT_RETRY_AUTHORIZED",
          "guard": "missionOwnerMatchesPendingRetryMissionEligibleAndHardLimitAllows",
          "to": "starting",
          "effects": [
            "recordHumanRetryAuthorization",
            "requestLocalAgentProcessStart",
            "journalDecision"
          ]
        },
        {
          "id": "A22",
          "from": ["stopping"],
          "event": "LOCAL_PROCESS_ABSENT",
          "guard": "matchingStopTokenRestartableReasonAndDescendantsQuiescent",
          "to": "interrupted",
