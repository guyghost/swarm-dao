{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-agent-workspace-persistence.graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "version", "milestone", "authority", "storageFormat", "persistedEntities", "machine", "recoveryTransitions", "invariants", "deferred"],
  "properties": {
    "$schema": { "const": "./local-agent-workspace-persistence.graph.schema.json" },
    "id": { "const": "swarm-dao-local-agent-workspace-persistence" },
    "version": { "const": 1 },
    "milestone": { "const": "m2-local-persistence" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durabilityState", "missionState", "agentState", "llm", "freeFormTextTransitions"],
      "properties": {
        "durabilityState": { "const": "persistence-recovery-machine" },
        "missionState": { "const": "mission-machine" },
        "agentState": { "const": "agent-machine" },
        "llm": { "const": "signal-only" },
        "freeFormTextTransitions": { "const": false }
      }
    },
    "storageFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentSchemaVersion", "supportedLegacyVersions", "committedFile", "atomicCommit", "integrityFields", "singleAuthority"],
      "properties": {
        "currentSchemaVersion": { "const": 1 },
        "supportedLegacyVersions": { "const": [0] },
        "committedFile": { "const": "workspace-v1.json" },
        "atomicCommit": { "$ref": "#/$defs/nonEmptyStrings" },
        "integrityFields": { "const": ["payloadHash", "checksum"] },
        "singleAuthority": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "persistedEntities": { "$ref": "#/$defs/nonEmptyStrings" },
    "machine": { "$ref": "#/$defs/machine" },
    "recoveryTransitions": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/recoveryTransition" }
    },
    "invariants": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "deferred": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "terminal"],
      "properties": { "id": { "$ref": "#/$defs/identifier" }, "terminal": { "type": "boolean" } }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sources"],
      "properties": {
        "type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["human", "ai", "system", "tool"] } }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "event", "guard", "to", "effects"],
      "properties": {
        "id": { "type": "string", "pattern": "^P[0-9]{2}$" },
        "from": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "event": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "guard": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "effects": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "initial", "states", "events", "transitions", "forbidden", "terminalStates"],
      "properties": {
        "id": { "const": "persistence-recovery-machine" },
        "initial": { "const": "uninitialized" },
        "states": { "type": "array", "minItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/state" } },
        "events": { "type": "array", "minItems": 13, "uniqueItems": true, "items": { "$ref": "#/$defs/event" } },
        "transitions": { "type": "array", "minItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/transition" } },
        "forbidden": { "$ref": "#/$defs/nonEmptyStrings" },
        "terminalStates": { "const": ["storage_blocked", "corrupt", "incompatible"] }
      }
    },
    "recoveryTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authorityMachine", "from", "event", "guard", "to", "effects"],
      "properties": {
        "id": { "type": "string", "pattern": "^RM[0-9]{2}$" },
        "authorityMachine": { "enum": ["mission-machine", "agent-machine"] },
        "from": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "event": { "const": "WORKSPACE_RESTART_RECOVERED" },
        "guard": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "effects": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule"],
      "properties": {
        "id": { "type": "string", "pattern": "^PINV-[0-9]{2}$" },
        "rule": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
